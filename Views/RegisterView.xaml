<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.RegisterView"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}">

    <ContentPage.Resources>
        <Style x:Key="errorMessage" TargetType="Label">
            <Setter Property="TextColor" Value="#D2042D"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="10,0,0,5"/>
            <Setter Property="FontAttributes" Value="Italic"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#69A481, Dark=#444444}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="5" VerticalOptions="Center">

            <Label Text="✨" FontSize="50" HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="Hozd létre a fiókod!"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                   Margin="0,0,0,25" />

            <Label Text="Teljes név" Margin="5,0" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
            <Border>
                <VerticalStackLayout>
                    <Entry Placeholder="Gipsz Jakab" Text="{Binding RegisterData.name}"/>
                    <Label Text="{Binding RegisterError.name[0]}" Style="{StaticResource errorMessage}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Email cím" Margin="5,0" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
            <Border>
                <VerticalStackLayout>
                    <Entry Placeholder="pelda@email.com" Keyboard="Email" Text="{Binding RegisterData.email}"/>
                    <Label Text="{Binding RegisterError.email[0]}" Style="{StaticResource errorMessage}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Jelszó" Margin="5,0" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
            <Border>
                <VerticalStackLayout>
                    <Entry Placeholder="••••••••" IsPassword="True" Text="{Binding RegisterData.password}"/>
                    <Label Text="{Binding RegisterError.password[0]}" Style="{StaticResource errorMessage}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Jelszó megerősítése" Margin="5,0" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
            <Border>
                <VerticalStackLayout>
                    <Entry Placeholder="••••••••" IsPassword="True" Text="{Binding RegisterData.confirm_password}"/>
                    <Label Text="{Binding RegisterError.confirm_password[0]}" Style="{StaticResource errorMessage}"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="REGISZTRÁCIÓ" 
                    Margin="0,15,0,20"
                    HeightRequest="55"
                    CornerRadius="25"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                    TextColor="{AppThemeBinding Light=White, Dark=Black}"
                    Command="{Binding onRegisterUserCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>