<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.LoginView"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}">

    <ContentPage.Resources>
        <Style x:Key="errorMessage" TargetType="Label">
            <Setter Property="TextColor" Value="#D2042D"/>
            <Setter Property="Margin" Value="10,5,0,0"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="FontAttributes" Value="Italic"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#69A481, Dark=#444444}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}"/>
            <Setter Property="PlaceholderColor" Value="Gray"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="30" VerticalOptions="Center" Spacing="5">

        <Label Text="🔑" FontSize="50" HorizontalOptions="Center" Margin="0,0,0,10"/>

        <Label Text="Log in!"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light=#333333, Dark=White}"
               Margin="0,0,0,30" />

        <Label Text="E-mail" 
               Margin="5,0"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
        <Border>
            <Entry Placeholder="email@example.com" 
                Text="{Binding UserEmail, Mode=TwoWay}" 
                Keyboard="Email" />
        </Border>

        <Label Text="Password" 
               Margin="5,0"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"/>
        <Border>
            <Entry Placeholder="••••••••" 
                IsPassword="True" 
                Text="{Binding UserPassword, Mode=TwoWay}" />
        </Border>

        <Button Text="Log in" 
                Margin="0,20,0,10"
                HeightRequest="55"
                CornerRadius="25"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                TextColor="{AppThemeBinding Light=White, Dark=Black}"
                Command="{Binding LoginCommand}" />

        <Label Text="{Binding ErrorMessage}" 
               Style="{StaticResource errorMessage}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

    </VerticalStackLayout>
</ContentPage>