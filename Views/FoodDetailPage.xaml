<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.FoodDetailPage"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#FAF9F6, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="{Binding Image}" 
                   Aspect="AspectFill" 
                   HeightRequest="300" 
                   HorizontalOptions="Fill" />

            <VerticalStackLayout Padding="20" Spacing="15">

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" 
                           Text="{Binding Name}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}" 
                           LineBreakMode="WordWrap" />

                    <Label Grid.Column="1" 
                           Text="{Binding Price, StringFormat='{0} Ft'}" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                           VerticalOptions="Center" 
                           Margin="10,0,0,0" />
                </Grid>

                <Label Text="Leírás" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                       Margin="0,10,0,0" />

                <Label Text="{Binding Description}" 
                       FontSize="16" 
                       TextColor="{AppThemeBinding Light=#444444, Dark=#E7EDEB}" 
                       LineHeight="1.4" />

                <Label Text="Összetevők" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                       Margin="0,10,0,0" />

                <Border StrokeShape="RoundRectangle 10" 
                        Padding="15" 
                        BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}"
                        StrokeThickness="0">
                    <Label Text="🍕 Prémium alapanyagok, titkos recept alapján készül." 
                           TextColor="{AppThemeBinding Light=#555555, Dark=#BBBBBB}" 
                           FontAttributes="Italic" />
                </Border>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>