<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TableWise.Models"
             x:Class="TableWise.Views.FoodDetailPage"
             x:DataType="models:FoodItem"
             Title="Details"
             BackgroundColor="{AppThemeBinding Light=#FAF9F6, Dark=#121212}">
    <ContentPage.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image Source="{Binding FullImageUrl}" 
                   Aspect="AspectFill" 
                   HeightRequest="300" 
                   HorizontalOptions="Fill" />

            <VerticalStackLayout Padding="20" Spacing="15">

                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" 
                           Text="{Binding Name}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}" 
                           LineBreakMode="WordWrap" />

                    <Label Grid.Column="1" 
                           Text="{Binding Price, StringFormat='{0} Ft'}" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                           VerticalOptions="Center" 
                           Margin="10,0,0,0" />
                </Grid>

                <BoxView HeightRequest="1" 
         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
         HorizontalOptions="Fill"
         Margin="0,10" />

                <Label Text="Ingredients" 
       FontSize="18" 
       FontAttributes="Bold" 
       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
       Margin="0,10,0,5" />

                <VerticalStackLayout x:Name="IngredientsList"
                    BindableLayout.ItemsSource="{Binding Ingredients}" 
                     Spacing="5"
                    BackgroundColor="Transparent"
                     >
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Margin="0,2" 
                Padding="12,8" 
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
                                <Border.Stroke>
                                    <AppThemeBinding Light="#69A481" Dark="Yellow" />
                                </Border.Stroke>
                                <Border.BackgroundColor>
                                    <AppThemeBinding Light="#F5F5F5" Dark="#2C2C2C" />
                                </Border.BackgroundColor>

                                <Label Text="{Binding .}" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Light=#333333, Dark=White}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>



            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>