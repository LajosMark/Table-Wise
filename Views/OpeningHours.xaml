<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.OpeningHours"
             Title="">
    <VerticalStackLayout Padding="30" Spacing="25">
        <Image Source="clock_icon.png" HeightRequest="80" HorizontalOptions="Center" />
        <Label Text="Mikor várunk téged?" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

        <Border StrokeShape="RoundRectangle 20" Padding="20" BackgroundColor="#FFF8F0" Stroke="DarkOrange">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Hétfő - Csütörtök" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="10:00 - 22:00" />
                </Grid>
                <BoxView HeightRequest="1" Color="LightGray" />

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Péntek - Szombat" FontAttributes="Bold" TextColor="DarkOrange" />
                    <Label Grid.Column="1" Text="10:00 - 00:00" FontAttributes="Bold" />
                </Grid>
                <BoxView HeightRequest="1" Color="LightGray" />

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Vasárnap" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="12:00 - 20:00" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label Text="⚠️ Ünnepnapokon a nyitvatartás változhat!" 
               FontSize="12" 
               TextColor="Red" 
               HorizontalOptions="Center" 
               Margin="0,20" />
    </VerticalStackLayout>
</ContentPage>