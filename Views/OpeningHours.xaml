<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.OpeningHours"
             Title="Nyitvatartás">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Image Source="clock_icon.png" 
                   HeightRequest="80" 
                   HorizontalOptions="Center" />

            <Label Text="Mikor várunk téged?" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <Border StrokeThickness="2" 
                    Padding="20" 
                    BackgroundColor="#FFF8F0" 
                    Stroke="DarkOrange">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Hétfő - Csütörtök" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="10:00 - 22:00" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Péntek - Szombat" FontAttributes="Bold" TextColor="DarkOrange" />
                        <Label Grid.Column="1" Text="10:00 - 00:00" FontAttributes="Bold" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="LightGray" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Vasárnap" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="12:00 - 20:00" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="⚠️ Ünnepnapokon a nyitvatartás változhat!" 
                   FontSize="12" 
                   TextColor="Red" 
                   HorizontalOptions="Center" 
                   Margin="0,5" />

            <Label Text="Itt találsz minket:" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,0" />

            <Border Stroke="LightBlue" 
        StrokeThickness="2" 
        Margin="10" 
        BackgroundColor="#F9F9F9">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center">
                    <Label Text="📍" FontSize="40" HorizontalOptions="Center" />

                    <Label Text="TableWise Étterem" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

                    <Label Text="1052 Budapest, Deák Ferenc tér 1." 
               FontSize="14" 
               TextColor="Gray"
               HorizontalOptions="Center" 
               HorizontalTextAlignment="Center" />

                    <Button Text="ÚTVONALTERVEZÉS INDÍTÁSA" 
                Clicked="OnOpenMapClicked"
                BackgroundColor="#34A853"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="50"
                WidthRequest="280" />

                    <Label Text="A gomb megnyitja a Google Maps-et" 
               FontSize="10" 
               TextColor="Silver" 
               HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#F0F8FF" 
                    Padding="15" 
                    Stroke="LightBlue" 
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Hol vagy most?" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <Label x:Name="LocationLabel" 
                           Text="Pozíció: Ismeretlen" 
                           FontSize="14" 
                           HorizontalOptions="Center" />

                    <Label x:Name="DistanceLabel" 
                           Text="Távolság az étteremtől: -- km" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="#2196F3"
                           HorizontalOptions="Center" />

                    <Button Text="Távolság lekérése" 
                            Clicked="OnGetLocationClicked"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="45" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>