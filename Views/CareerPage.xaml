<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.Views.CareerPage"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Csatlakozz hozzánk! 🤝" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,10"
                   TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

            <Label Text="Szeretnél egy dinamikus csapat tagja lenni? Nézd meg aktuális ajánlatainkat!" 
                   HorizontalTextAlignment="Center" 
                   TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" />

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="🍕" FontSize="35" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Pizzaszakács" 
                               FontAttributes="Bold" 
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Teljes munkaidő • Versenyképes bér" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" />

                        <Button Text="Jelentkezem" 
                                Margin="0,10,0,0" 
                                HeightRequest="40" 
                                CornerRadius="20"
                                FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                                TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.1" />
                </Border.Shadow>

                <HorizontalStackLayout Spacing="15">
                    <Label Text="🛵" FontSize="35" VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Futár" 
                               FontAttributes="Bold" 
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Rugalmas beosztás • Azonnali kezdés" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" />

                        <Button Text="Jelentkezem" 
                                Margin="0,10,0,0" 
                                HeightRequest="40" 
                                CornerRadius="20"
                                FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                                TextColor="{AppThemeBinding Light=White, Dark=Black}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>