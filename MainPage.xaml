<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TableWise.MainPage">

    <ScrollView>
        <VerticalStackLayout>

            <CarouselView x:Name="PromocioCarousel"
                  HeightRequest="200"
                  HorizontalOptions="Fill"
                  Loop="True"
                  IndicatorView="indicatorView">

                <CarouselView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>diakedvezmeny.png</x:String>
                        <x:String>dolgozznalunk.png</x:String>
                        <x:String>egyetfizet.png</x:String>
                    </x:Array>
                </CarouselView.ItemsSource>

                <CarouselView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" 
                               SnapPointsAlignment="Center" 
                               SnapPointsType="MandatorySingle" />
                </CarouselView.ItemsLayout>

                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <ContentView Padding="10,0">
                            <Border StrokeThickness="0"
                            HeightRequest="200"
                            HorizontalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <Image Source="{Binding .}" 
                               Aspect="AspectFill"
                               HeightRequest="200"
                               HorizontalOptions="Fill" />
                            </Border>
                        </ContentView>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView x:Name="indicatorView"
                           ItemsSource="{Binding ItemsSource, Source={x:Reference PromocioCarousel}}"
                   IndicatorColor="LightGray"
                   SelectedIndicatorColor="DarkOrange"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

            <Label Text="Kategóriák" 
       FontSize="20" 
       FontAttributes="Bold" 
       Margin="20,10,0,10" 
       TextColor="Black" />

            <CollectionView HeightRequest="120"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Pizzák</x:String>
                        <x:String>Burgerek</x:String>
                        <x:String>Italok</x:String>
                        <x:String>Desszertek</x:String>
                        <x:String>Saláták</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="5" Padding="10,0">
                            <Border StrokeShape="RoundRectangle 25"
                        HeightRequest="60"
                        WidthRequest="60"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.1" />
                                </Border.Shadow>

                                <Label Text="🍽️" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           FontSize="25" />
                            </Border>

                            <Label Text="{Binding .}" 
                       HorizontalOptions="Center" 
                       FontSize="12" 
                       TextColor="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Népszerű ételek" FontSize="18" FontAttributes="Bold" />
            <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                
            </FlexLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
