<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TableWise.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:TableWise"
             x:Class="TableWise.MainPage"
             x:DataType="local:MainPage"
             BackgroundColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}"
             Title="">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior 
            StatusBarColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>

    <Grid>
        <CollectionView x:Name="FoodCollectionView"
                        ItemsSource="{Binding FoodGroups}" 
                        IsGrouped="True"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="0,0,0,10">

                    <CarouselView x:Name="PromocioCarousel"
                                  HeightRequest="200"
                                  Loop="True"
                                  IndicatorView="indicatorView">
                        <CarouselView.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>diakedvezmeny.png</x:String>
                                <x:String>dolgozznalunk.png</x:String>
                                <x:String>egyetfizet.png</x:String>
                            </x:Array>
                        </CarouselView.ItemsSource>
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ContentView Padding="10,0">
                                    <Border StrokeThickness="0" HeightRequest="200">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding .}" Aspect="AspectFill" />
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="indicatorView"
                                   IndicatorColor="LightGray"
                                   SelectedIndicatorColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"
                                   HorizontalOptions="Center" />

                    <Label Text="Categories" FontSize="20" FontAttributes="Bold" Margin="20,0"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

                    <CollectionView ItemsSource="{Binding Categories}" 
                                    HeightRequest="120" 
                                    SelectionMode="Single"
                                    SelectionChanged="OnCategorySelected">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                        </CollectionView.ItemsLayout>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <VerticalStackLayout Spacing="5" Padding="10,0">
                                    <Border StrokeShape="RoundRectangle 25" HeightRequest="60" WidthRequest="60"
                                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" 
                                            StrokeThickness="2"
                                            Stroke="{AppThemeBinding Light=#69A481, Dark=Yellow}">
                                        <Image Source="{Binding Icon}" Aspect="AspectFit" Margin="10" />
                                    </Border>
                                    <Label Text="{Binding Name}" HorizontalOptions="Center" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#333333, Dark=White}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:CategoryGroup">
                    <Label Text="{Binding Name}" FontSize="22" FontAttributes="Bold" Margin="20,15,20,5"
                           TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodItem">
                    <Border StrokeShape="RoundRectangle 15" Margin="20,8" Padding="10" 
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                            StrokeThickness="0.5"
                            Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" HeightRequest="80" WidthRequest="80" StrokeThickness="0">
                                <Image Source="{Binding Image}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding Description}" FontSize="12" 
                                       TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" MaxLines="2" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Price, StringFormat='{0} Ft'}" 
                                   FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#0A0A0A}" 
                                     Padding="30" Margin="0,20,0,0">
                    <Label Text="© 2026 TableWise Restaurant" HorizontalOptions="Center" 
                           TextColor="{AppThemeBinding Light=Gray, Dark=#666666}" />
                    <Label Text="Minden jog fenntartva." HorizontalOptions="Center" FontSize="10" 
                           TextColor="{AppThemeBinding Light=Gray, Dark=#666666}" />
                </VerticalStackLayout>
            </CollectionView.Footer>

        </CollectionView>

        <Button Text="↑" FontSize="25" CornerRadius="27" HeightRequest="55" WidthRequest="55"
                BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                TextColor="{AppThemeBinding Light=White, Dark=Black}"
                VerticalOptions="End" HorizontalOptions="End" Margin="20"
                Clicked="OnScrollToTopClicked">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="10" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>