<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TableWise.Models"
             xmlns:local="clr-namespace:TableWise"
             x:Class="TableWise.MainPage"
             x:DataType="local:MainPage"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#E7EDEB, Dark=#121212}">
    <Grid>
        <ScrollView x:Name="MainScrollView">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,20">

                <CarouselView x:Name="PromocioCarousel"
                              HeightRequest="200"
                              HorizontalOptions="Fill"
                              Loop="True"
                              IndicatorView="indicatorView">
                    <CarouselView.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>diakedvezmeny.png</x:String>
                            <x:String>dolgozznalunk.png</x:String>
                            <x:String>egyetfizet.png</x:String>
                        </x:Array>
                    </CarouselView.ItemsSource>
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <ContentView Padding="10,0">
                                <Border StrokeThickness="0" HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding .}" Aspect="AspectFill" />
                                </Border>
                            </ContentView>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <IndicatorView x:Name="indicatorView"
                               ItemsSource="{Binding ItemsSource, Source={x:Reference PromocioCarousel}}"
                               IndicatorColor="LightGray"
                               SelectedIndicatorColor="{AppThemeBinding Light=#69A481, Dark=Yellow}"
                               HorizontalOptions="Center" />

                <Label Text="Kategóriák" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       Margin="20,0" 
                       TextColor="{AppThemeBinding Light=#333333, Dark=White}" />

                <CollectionView ItemsSource="{Binding Categories}" 
                                HeightRequest="120" 
                                SelectionMode="Single"
                                SelectionChanged="OnCategorySelected">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <VerticalStackLayout Spacing="5" Padding="10,0">
                                <Border StrokeShape="RoundRectangle 25" 
                                        HeightRequest="60" 
                                        WidthRequest="60" 
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" 
                                        StrokeThickness="2"
                                        Stroke="{AppThemeBinding Light=#69A481, Dark=Yellow}">
                                    <Image Source="{Binding Icon}" Aspect="AspectFit" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                </Border>
                                <Label Text="{Binding Name}" 
                                       HorizontalOptions="Center" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#333333, Dark=White}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!--    Pizzák    -->

                <Label Text="🍕 Pizzák" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       Margin="20,10" 
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />

                <VerticalStackLayout x:Name="PizzaSection" Padding="20,0" BindableLayout.ItemsSource="{Binding Pizzas}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodItem">
                            <Border StrokeShape="RoundRectangle 15" 
                                    Margin="0,10" 
                                    Padding="10" 
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                                    StrokeThickness="0.5"
                                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="{AppThemeBinding Light=0.1, Dark=0.5}" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="10" Rect="0,0,80,80" />
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               FontSize="16" 
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label Text="{Binding Description}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='{0} Ft'}" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!--    Burgerek    -->

                <Label Text="🍔 Burgerek" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       Margin="20,10" 
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />

                <VerticalStackLayout x:Name="BurgerSection" Padding="20,0" BindableLayout.ItemsSource="{Binding Burgers}">


                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodItem">
                            <Border StrokeShape="RoundRectangle 15" 
                    Margin="0,10" 
                    Padding="10" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                    StrokeThickness="0.5"
                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="{AppThemeBinding Light=0.1, Dark=0.5}" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="10" Rect="0,0,80,80" />
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                               FontAttributes="Bold" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label Text="{Binding Description}" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='{0} Ft'}" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!--    Italok    -->

                <Label Text="🥤 Italok" 
       FontSize="22" 
       FontAttributes="Bold" 
       Margin="20,10"
       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />

                <VerticalStackLayout x:Name="DrinkSection" Padding="20,0" BindableLayout.ItemsSource="{Binding Drinks}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodItem">
                            <Border StrokeShape="RoundRectangle 15" 
                    Margin="0,10" 
                    Padding="10" 
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                    StrokeThickness="0.5"
                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="{AppThemeBinding Light=0.1, Dark=0.5}" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="10" Rect="0,0,80,80" />
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                               FontAttributes="Bold" 
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label Text="{Binding Description}" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='{0} Ft'}" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!--    Desszertek    -->

                <Label Text="🍰 Desszertek" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       Margin="20,10"
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />

                <VerticalStackLayout x:Name="DessertSection" Padding="20,0" BindableLayout.ItemsSource="{Binding Desserts}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodItem">
                            <Border StrokeShape="RoundRectangle 15" 
                                    Margin="0,10" 
                                    Padding="10" 
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                                    StrokeThickness="0.5"
                                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="{AppThemeBinding Light=0.1, Dark=0.5}" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="10" Rect="0,0,80,80" />
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label Text="{Binding Description}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='{0} Ft'}" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                
                <!--    Saláták    -->

                <Label Text="🥗 Saláták" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       Margin="20,10"
                       TextColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}" />

                <VerticalStackLayout x:Name="SaladSection" Padding="20,0" BindableLayout.ItemsSource="{Binding Salads}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:FoodItem">
                            <Border StrokeShape="RoundRectangle 15" 
                                    Margin="0,10" 
                                    Padding="10" 
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                                    StrokeThickness="0.5"
                                    Stroke="{AppThemeBinding Light=#69A481, Dark=#444444}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Opacity="{AppThemeBinding Light=0.1, Dark=0.5}" Radius="5" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="100, *, Auto" ColumnSpacing="15">
                                    <Image Grid.Column="0" Source="{Binding Image}" Aspect="AspectFill" HeightRequest="80" WidthRequest="80">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="10" Rect="0,0,80,80" />
                                        </Image.Clip>
                                    </Image>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold" 
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                        <Label Text="{Binding Description}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                                               MaxLines="2" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='{0} Ft'}" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#69A481, Dark=Yellow}" 
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#0A0A0A}" 
                                     Padding="30" 
                                     Margin="0,20,0,0">
                    <Label Text="© 2026 TableWise Restaurant" 
                           HorizontalOptions="Center" 
                           TextColor="{AppThemeBinding Light=Gray, Dark=#666666}" />
                    <Label Text="Minden jog fenntartva." 
                           HorizontalOptions="Center" 
                           FontSize="10" 
                           TextColor="{AppThemeBinding Light=Gray, Dark=#666666}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="↑" 
                FontSize="25"
                BackgroundColor="{AppThemeBinding Light=#D2042D, Dark=Yellow}"
                TextColor="{AppThemeBinding Light=White, Dark=Black}"
                HeightRequest="55"
                WidthRequest="55"
                CornerRadius="27"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="20"
                Clicked="OnScrollToTopClicked">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="10" />
            </Button.Shadow>
        </Button>
    </Grid>

</ContentPage>
