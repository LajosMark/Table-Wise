@baseUrl = http://localhost:3000
@token = 

### Get all meals
GET {{baseUrl}}/api/meals

### Get meal by id
GET {{baseUrl}}/api/meals/1

### Create a new meal (admin/manager only)
POST {{baseUrl}}/api/meals
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "REST Test Meal",
  "ingridientId": 101,
  "price": 2500,
  "categoryId": 1,
  "isAvailable": true
}

### Upload image for meal 1 (admin/manager only)
# Set a valid local image file path in the request below before sending.
POST {{baseUrl}}/api/meals/1/image
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="test-image.jpg"
Content-Type: image/jpeg

< ./test-image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Update meal (admin/manager only)
PATCH {{baseUrl}}/api/meals/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "price": 2700
}

### Delete meal (admin only)
DELETE {{baseUrl}}/api/meals/1
Authorization: Bearer {{token}}
